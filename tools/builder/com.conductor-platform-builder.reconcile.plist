<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.conductor-platform-builder.reconcile</string>

  <!-- ADR-0016: the reconciler is an INDEPENDENT launchd job, NOT embedded in
       the builder tick loop. This is what lets it recover a dead/wedged builder
       (a conductor cannot rescue its own death). It is deterministic (no LLM),
       so it can run as the FDA-scoped builder-bash too. It needs FDA only to git
       log the repo + kickstart the tick job; inherits the grant like the tick. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/atakan/.conductor-platform-builder/builder-bash</string>
    <string>-c</string>
    <string>exec python3 /Users/atakan/Documents/GitHub/conductor-platform/tools/builder/auto-reconcile.py</string>
  </array>

  <!-- Every 3 min — tighter than the tick so a dead tick is caught quickly. -->
  <key>StartInterval</key><integer>180</integer>
  <key>RunAtLoad</key><true/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/atakan/.local/bin:/Users/atakan/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/local/go/bin:/opt/homebrew/go/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/atakan</string>
  </dict>

  <key>WorkingDirectory</key><string>/Users/atakan/Documents/GitHub/conductor-platform</string>
  <key>StandardOutPath</key><string>/Users/atakan/.conductor-platform-builder/reconcile.launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/atakan/.conductor-platform-builder/reconcile.launchd.err.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
