tsconfig.json
tsconfig.test.json
tsconfig.webview.json
eslint.config.mjs
vitest.config.ts
esbuild.config.mjs
esbuild.config.d.mts
go.mod
.gitignore
.vscodeignore
package-lock.json

**/.DS_Store
