{
  "name": "conductor-editor",
  "private": true,
  "version": "0.0.0",
  "publisher": "everva",
  "displayName": "Conductor",
  "description": "Conductor Platform — agent-fleet cockpit inside the editor (Faz-4).",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Conductor",
      "properties": {
        "conductor.gatewayUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "The conductor-api gateway base URL. The bearer token is NOT stored here — it lives in VS Code SecretStorage (set it via the \"Conductor: Connect to Gateway\" command)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "conductor",
          "title": "Conductor",
          "icon": "media/conductor.svg"
        }
      ],
      "panel": [
        {
          "id": "conductorEvents",
          "title": "Conductor Events",
          "icon": "media/conductor.svg"
        }
      ]
    },
    "views": {
      "conductor": [
        {
          "id": "conductor.sessions",
          "name": "Conductors"
        },
        {
          "id": "conductor.activity",
          "name": "Activity"
        },
        {
          "id": "conductor.diagnostics",
          "name": "Diagnostics"
        }
      ],
      "conductorEvents": [
        {
          "id": "conductor.events",
          "name": "Events"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "conductor.sessions",
        "contents": "No Conductors to show.\n[Connect to a gateway](command:conductor.connect)\nto see your projects and sessions."
      },
      {
        "view": "conductor.events",
        "contents": "No events yet.\n[Connect to a gateway](command:conductor.connect)\nto watch the live event stream."
      }
    ],
    "commands": [
      {
        "command": "conductor.open",
        "title": "Conductor: Open Command Center",
        "category": "Conductor"
      },
      {
        "command": "conductor.openSession",
        "title": "Conductor: Open Session",
        "category": "Conductor"
      },
      {
        "command": "conductor.newWork",
        "title": "Conductor: New Work (Intake)",
        "category": "Conductor"
      },
      {
        "command": "conductor.refreshSessions",
        "title": "Conductor: Refresh Conductors",
        "category": "Conductor",
        "icon": "$(refresh)"
      },
      {
        "command": "conductor.refreshDiagnostics",
        "title": "Conductor: Refresh Diagnostics",
        "category": "Conductor",
        "icon": "$(refresh)"
      },
      {
        "command": "conductor.connect",
        "title": "Conductor: Connect to Gateway",
        "category": "Conductor"
      },
      {
        "command": "conductor.disconnect",
        "title": "Conductor: Disconnect",
        "category": "Conductor"
      },
      {
        "command": "conductor.login",
        "title": "Conductor: Log In (Claude)",
        "category": "Conductor"
      },
      {
        "command": "conductor.logout",
        "title": "Conductor: Log Out (Claude)",
        "category": "Conductor"
      },
      {
        "command": "conductor.pushCredential",
        "title": "Conductor: Push Login to Gateway",
        "category": "Conductor"
      },
      {
        "command": "conductor.removeCredential",
        "title": "Conductor: Remove Login from Gateway",
        "category": "Conductor"
      },
      {
        "command": "conductor.pause",
        "title": "Conductor: Pause Project",
        "category": "Conductor"
      },
      {
        "command": "conductor.resume",
        "title": "Conductor: Resume Project",
        "category": "Conductor"
      },
      {
        "command": "conductor.abort",
        "title": "Conductor: Abort Running Task",
        "category": "Conductor"
      },
      {
        "command": "conductor.approve",
        "title": "Conductor: Approve Awaiting Task",
        "category": "Conductor"
      },
      {
        "command": "conductor.showDiff",
        "title": "Conductor: Show Task Diff",
        "category": "Conductor"
      },
      {
        "command": "conductor.openTaskDiff",
        "title": "Conductor: Open Task Diff",
        "category": "Conductor",
        "icon": "$(git-compare)"
      },
      {
        "command": "conductor.showEventJson",
        "title": "Conductor: Show Event JSON",
        "category": "Conductor",
        "icon": "$(json)"
      },
      {
        "command": "conductor.retryTask",
        "title": "Conductor: Retry Blocked Task",
        "category": "Conductor",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "conductor.refreshSessions",
          "when": "view == conductor.sessions",
          "group": "navigation"
        },
        {
          "command": "conductor.refreshDiagnostics",
          "when": "view == conductor.diagnostics",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "conductor.openSession",
          "when": "view == conductor.sessions && viewItem =~ /conductorTask/",
          "group": "navigation@1"
        },
        {
          "command": "conductor.openTaskDiff",
          "when": "view == conductor.sessions && viewItem =~ /conductorTask/",
          "group": "navigation@2"
        },
        {
          "command": "conductor.approve",
          "when": "view == conductor.sessions && viewItem == conductorProject",
          "group": "1_control@1"
        },
        {
          "command": "conductor.pause",
          "when": "view == conductor.sessions && viewItem == conductorProject",
          "group": "1_control@2"
        },
        {
          "command": "conductor.resume",
          "when": "view == conductor.sessions && viewItem == conductorProject",
          "group": "1_control@3"
        },
        {
          "command": "conductor.abort",
          "when": "view == conductor.sessions && viewItem == conductorProject",
          "group": "1_control@4"
        },
        {
          "command": "conductor.retryTask",
          "when": "view == conductor.sessions && viewItem == conductorTaskBlocked",
          "group": "navigation@3"
        },
        {
          "command": "conductor.showEventJson",
          "when": "view == conductor.events",
          "group": "navigation@1"
        },
        {
          "command": "conductor.openTaskDiff",
          "when": "view == conductor.events && viewItem =~ /conductorEvent\\.(review|blocked|diff)/",
          "group": "navigation@2"
        },
        {
          "command": "conductor.retryTask",
          "when": "view == conductor.events && viewItem == conductorEvent.blocked",
          "group": "1_control@1"
        },
        {
          "command": "conductor.approve",
          "when": "view == conductor.events && viewItem == conductorEvent.review",
          "group": "1_control@1"
        },
        {
          "command": "conductor.abort",
          "when": "view == conductor.events && viewItem == conductorEvent.review",
          "group": "1_control@2"
        }
      ],
      "commandPalette": [
        {
          "command": "conductor.openSession",
          "when": "false"
        },
        {
          "command": "conductor.openTaskDiff",
          "when": "false"
        },
        {
          "command": "conductor.showEventJson",
          "when": "false"
        },
        {
          "command": "conductor.retryTask",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "conductor.open",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "conductor.showDiff",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "conductor.connected"
      },
      {
        "command": "conductor.refreshSessions",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "conductor.connected"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "node esbuild.config.mjs",
    "gate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "compile:vscode-smoke": "tsc -p tsconfig.test.json",
    "pretest:vscode": "npm run build && npm run compile:vscode-smoke",
    "test:vscode": "node ./out-test/runVscodeSmoke.js"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.0.5"
  }
}
