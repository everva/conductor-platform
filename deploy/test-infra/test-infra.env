# Connection contract for the everva-hosted optiway test-infra. Both conductor agents
# (davinci + everva) load this into the verify gate so optiway's tests run against the
# REAL services. HOST = everva's tailscale IP (100.75.17.55) — reachable from BOTH hosts
# (davinci over tailscale; everva can reach its own tailnet IP too).
#
# These are TEST-ONLY fake secrets (mirrors optiway docker-compose.qa.yml env) — NOT real
# credentials. Safe to commit.

# --- backing services ---
DATABASE_URL=postgresql://optiway:optiway_dev@100.75.17.55:5142/optiway_qa
REDIS_URL=redis://100.75.17.55:6489
REDIS_HOST=100.75.17.55
REDIS_PORT=6489
MQTT_URL=mqtt://100.75.17.55:1883
RABBITMQ_URL=amqp://optiway:optiway_dev@100.75.17.55:5772
TEMPORAL_ADDRESS=100.75.17.55:7433
TEMPORAL_NAMESPACE=optiway-jobs

# --- optiway test/app config (fake QA values) ---
INTERNAL_API_TOKEN=qa-internal-token-2026
JWT_SECRET=qa-jwt-secret-change-me-2026
JWT_ACCESS_SECRET=qa-access-secret-change-me-2026
JWT_REFRESH_SECRET=qa-refresh-secret-change-me-2026
BOARDING_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
USE_TEMPORAL_ROUTE_CALC=true
USE_TEMPORAL_IMPORTS=true
USE_TEMPORAL_DELIVERY=true
USE_TEMPORAL_INTEGRATIONS=true
USE_TEMPORAL_AI=false
LOG_LEVEL=info
