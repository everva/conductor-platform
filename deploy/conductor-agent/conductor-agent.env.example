# conductor-agent environment (copy to conductor-agent.env, chmod 600, fill in).
# Secrets are read from THIS file by the agent (token, gh-token); config flags are
# expanded into ExecStart by systemd.

# --- secrets (REQUIRED) ---
# Gateway bearer token. Fetch from the cluster:
#   kubectl --context hetzner-k8s-1 -n conductor get secret conductor-secret \
#     -o jsonpath='{.data.CONDUCTOR_API_TOKEN}' | base64 -d
CONDUCTOR_AGENT_TOKEN=

# GitHub token to clone + push the (private) optiway repo. A fine-grained PAT (or
# `gh auth token`) with Contents: read+write on everva/optiway. Used by the
# provisioner's credential helper and STRIPPED from the performer subprocess env.
CONDUCTOR_GH_TOKEN=

# Claude OAuth token for the performer (`claude -p`). The SSH-free path (Faz L1/L2,
# ADR-0049): in the Conductor Editor run "Conductor: Log In" — it runs `claude setup-token`
# (browser OAuth) and stores the printed portable token; paste that same token here. (Or run
# `claude setup-token` directly on a machine with a browser and copy the result.) Unlike an
# interactive `claude` login this token is host-portable, so you mint it once and drop it in.
# envsafe KEEPS this var, so it reaches the `claude -p` subprocess. Leave empty ONLY if this
# host already has an interactive claude login. NEVER commit a filled-in value (chmod 600).
CLAUDE_CODE_OAUTH_TOKEN=

# --- config (flags) ---
# Gateway URL over tailscale (davinci → conductor-api node). Verified reachable.
CONDUCTOR_GATEWAY=http://conductor-api:8080
# The onboarded project id (the gateway derived "optiway" from the repo).
CONDUCTOR_PROJECT=optiway
# The repo to clone (https so the gh-token credential helper authenticates).
CONDUCTOR_REPO=https://github.com/everva/optiway.git
# The base branch conductor work merges onto. optiway main is NEVER touched.
CONDUCTOR_BASE=conductor/optiway
# Directory holding .conductor/config.yaml (the recipe: develop cmd + verify gates).
# Point at the optiway checkout that carries the committed recipe.
CONDUCTOR_RECIPE_DIR=/home/davinci/optiway-conductor
# Host capabilities for routing (must cover the scenario's requires; optiway's first
# scenario requires nothing, so any value works).
CONDUCTOR_CAPABILITIES=linux,backend
# Writable workspace root (clones + worktrees).
CONDUCTOR_ROOT=/home/davinci/.conductor-agent
